# ============================================================
# MAKEFILE — Rapport Think Tank : Markdown → LaTeX → PDF (bib2gls)
# ============================================================
# Auteur : Bruno De Dominicis
# Projet : TianDao-Topology / Documents/en
# ============================================================
# Commandes
# make -f Makefile.tank : Compile le PDF complet + copie automatique vers out/ et la racine
# make -f Makefile.tank pdf : Idem (cible par défaut)
# make -f Makefile.tank inserer : Force la régénération du *_indexe.md (même si la source n'a pas changé)
# make -f Makefile.tank publish : Recopie out/doc_unique_en_21-11.pdf vers la racine sans recompiler
# make -f Makefile.tank index : Régénère uniquement les index (bib2gls + biber)
# make -f Makefile.tank analyse : Analyse des occurrences des termes
# make -f Makefile.tank manquants : Détecte les termes absents du texte
# make -f Makefile.tank test : Test de conversion Pandoc (génère build/test.tex)
# make -f Makefile.tank clean : Nettoyage temporaire (garde les PDF dans out/ et à la racine)
# make -f Makefile.tank cleanall : Supprime build/ et out/ — le PDF racine est CONSERVÉ
# make -f Makefile.tank help : Affiche l'aide
# ============================================================
# Intermédiaires : build/   PDF final : out/ + racine (README)
# ============================================================
SHELL         := /bin/bash
.DEFAULT_GOAL := all
PANDOC        := pandoc
PDFLATEX      := xelatex
BIB2GLS       := bib2gls
BIBER         := biber
PYTHON        := python3

# Répertoires
SRC_DIR     := src
BIB_DIR     := bib
SCRIPTS_DIR := scripts
BUILD_DIR   := build
OUT_DIR     := out
IMG_DIR     := images

# ============================================================
# NOM DU DOCUMENT — SEUL ENDROIT À MODIFIER POUR UNE NOUVELLE VERSION
# ============================================================
DOCNAME     := rapport_thinktank_en_21-11

MAIN_MD     := $(SRC_DIR)/$(DOCNAME)_indexe.md
MD_SOURCE   := $(SRC_DIR)/$(DOCNAME).md
INSERER_SCRIPT := $(SCRIPTS_DIR)/inserer_index_thinktank.py
TEMPLATE    := template.tex
MAIN_TEX    := $(BUILD_DIR)/$(DOCNAME).tex
MAIN_PDF    := $(OUT_DIR)/$(DOCNAME).pdf
ROOT_PDF    := $(DOCNAME).pdf
MAIN_AUX    := $(BUILD_DIR)/$(DOCNAME).aux
MAIN_BCF    := $(BUILD_DIR)/$(DOCNAME).bcf
MAIN_BBL    := $(BUILD_DIR)/$(DOCNAME).bbl
MAIN_GLS    := $(BUILD_DIR)/$(DOCNAME).gls

# ============================================================
# BIBLIOGRAPHIE ET INDEX
# ============================================================
BIB_BIBLIO    := $(BIB_DIR)/biblio-unique.bib
BIB_INDEX_RAW := $(BIB_DIR)/notations.bib $(BIB_DIR)/glossaire_v2.bib \
$(BIB_DIR)/mots_cles.bib
BIB_INDEX := $(wildcard $(BIB_INDEX_RAW))
BIB_ALL   := $(wildcard $(BIB_BIBLIO) $(BIB_INDEX))

# ============================================================
# OPTIONS
# ============================================================
PANDOC_OPTS := -f markdown+raw_tex+pipe_tables+footnotes+tex_math_dollars+tex_math_single_backslash+raw_attribute+citations \
-t latex \
--standalone \
--toc \
--toc-depth=4 \
--number-sections \
--template=$(TEMPLATE) \
--biblatex \
--bibliography=$(BIB_DIR)/biblio-unique.bib \
--variable=lang:en \
--variable=colorlinks:true \
--variable=linkcolor:blue \
--variable=urlcolor:blue \
--variable=toc-title:"Table des matières" \
--resource-path=$(SRC_DIR):$(IMG_DIR):$(BIB_DIR):. \
--variable=biblatexoptions:"backend=biber,style=authoryear,sorting=nyt"

PDFLATEX_OPTS := -interaction=nonstopmode -halt-on-error -output-directory=$(BUILD_DIR) -shell-escape
BIBER_OPTS    := --input-directory $(BUILD_DIR) --output-directory $(BUILD_DIR)
BIB2GLS_OPTS  := --dir $(BUILD_DIR) --tex-encoding utf8 --group

.PHONY: all pdf inserer publish index analyse manquants test clean clean_index cleanall help
all: pdf
pdf: $(MAIN_PDF)

# ============================================================
# INSERTION — script dédié think tank (protections {=latex},
# tableaux markdown, termes chinois exclus)
# ============================================================
$(MAIN_MD): $(MD_SOURCE) $(INSERER_SCRIPT)
	@echo "============================================================"
	@echo "  Insertion automatique des \\glsadd{} (think tank)"
	@echo "============================================================"
	$(PYTHON) $(INSERER_SCRIPT) $(MD_SOURCE) $(MAIN_MD)
	@echo "✅ Markdown indexé : $(MAIN_MD)"

inserer:
	@echo "============================================================"
	@echo "  Insertion FORCÉE des \\glsadd{} (think tank)"
	@echo "============================================================"
	$(PYTHON) $(INSERER_SCRIPT) $(MD_SOURCE) $(MAIN_MD)
	@echo "✅ Markdown indexé : $(MAIN_MD)"

# ============================================================
# Conversion Markdown indexé → LaTeX
# ============================================================
$(MAIN_TEX): $(MAIN_MD) $(TEMPLATE) $(BIB_ALL)
	@echo "============================================================"
	@echo "  Conversion Markdown → LaTeX"
	@echo "============================================================"
	@mkdir -p $(BUILD_DIR)
	$(PANDOC) $(PANDOC_OPTS) -o $(MAIN_TEX) $(MAIN_MD)
	@echo "✅ LaTeX généré : $(MAIN_TEX)"

# ============================================================
# Étape 1 : Première compilation LaTeX
# ============================================================
$(MAIN_AUX): $(MAIN_TEX)
	@echo "============================================================"
	@echo "  Étape 1/4 : Première compilation LaTeX"
	@echo "============================================================"
	$(PDFLATEX) $(PDFLATEX_OPTS) $(MAIN_TEX)
	@echo "✅ .aux / .bcf générés"

# ============================================================
# Étape 2 : Bibliographie (biber)
# ============================================================
$(MAIN_BBL): $(MAIN_AUX)
	@echo "============================================================"
	@echo "  Étape 2/4 : Bibliographie (biber)"
	@echo "============================================================"
	@if [ -f $(MAIN_BCF) ]; then \
		$(BIBER) $(BIBER_OPTS) $(DOCNAME); \
		echo "✅ Bibliographie générée"; \
	else \
		echo "⚠️ Fichier .bcf non trouvé"; \
	fi

# ============================================================
# Étape 3 : bib2gls — 1er passage
# ============================================================
$(MAIN_GLS): $(MAIN_AUX) $(BIB_INDEX)
	@echo "============================================================"
	@echo "  Étape 3/4 : bib2gls — 1er passage"
	@echo "============================================================"
	@if [ -f $(MAIN_AUX) ]; then \
		$(BIB2GLS) $(BIB2GLS_OPTS) $(DOCNAME); \
		echo "✅ bib2gls 1er passage OK"; \
	else \
		echo "⚠️ Fichier .aux introuvable"; \
	fi

# ============================================================
# Compilation finale + déploiement à la racine
# ============================================================
$(MAIN_PDF): $(MAIN_TEX) $(MAIN_GLS) $(MAIN_BBL)
	@echo "============================================================"
	@echo "  Compilation finale"
	@echo "============================================================"
	@mkdir -p $(OUT_DIR)
	@echo "→ xelatex (1/3)"
	$(PDFLATEX) $(PDFLATEX_OPTS) $(MAIN_TEX)
	@echo "→ biber (relance)"
	-$(BIBER) $(BIBER_OPTS) $(DOCNAME)
	@echo "→ bib2gls (2e passage)"
	-$(BIB2GLS) $(BIB2GLS_OPTS) $(DOCNAME)
	@echo "→ xelatex (2/3)"
	$(PDFLATEX) $(PDFLATEX_OPTS) $(MAIN_TEX)
	@echo "→ xelatex (3/3) — stabilisation"
	$(PDFLATEX) $(PDFLATEX_OPTS) $(MAIN_TEX)
	@if [ -f $(BUILD_DIR)/$(DOCNAME).pdf ]; then \
		cp $(BUILD_DIR)/$(DOCNAME).pdf $(MAIN_PDF); \
		cp $(BUILD_DIR)/$(DOCNAME).pdf $(ROOT_PDF); \
		echo ""; \
		echo "✅ PDF généré      : $(MAIN_PDF)"; \
		echo "✅ PDF publié (racine) : $(ROOT_PDF)"; \
		ls -lh $(MAIN_PDF) $(ROOT_PDF); \
	else \
		echo ""; \
		echo "❌ ÉCHEC : le PDF n'a pas été généré."; \
		exit 1; \
	fi

# ============================================================
# PUBLISH — recopie le PDF vers la racine sans recompiler
# ============================================================
publish:
	@if [ -f $(MAIN_PDF) ]; then \
		cp $(MAIN_PDF) $(ROOT_PDF); \
		echo "✅ PDF publié : $(ROOT_PDF)"; \
		ls -lh $(ROOT_PDF); \
	else \
		echo "❌ $(MAIN_PDF) introuvable — lancez d'abord make pdf"; \
		exit 1; \
	fi

# ============================================================
# Cibles utilitaires
# ============================================================
index: clean_index $(MAIN_GLS) $(MAIN_BBL)

clean_index:
	@rm -f $(BUILD_DIR)/*.idx $(BUILD_DIR)/*.ind $(BUILD_DIR)/*.glo \
		$(BUILD_DIR)/*.gls $(BUILD_DIR)/*.glsdefs $(BUILD_DIR)/*.bbl \
		$(BUILD_DIR)/*.bcf $(BUILD_DIR)/*.glg $(BUILD_DIR)/*.glstex

analyse:
	@echo "=== Analyse des occurrences ==="
	$(PYTHON) $(SCRIPTS_DIR)/extraire_occurrences.py

manquants:
	@echo "=== Détection des termes manquants ==="
	$(PYTHON) $(SCRIPTS_DIR)/detecter_manquants.py

test:
	@echo "=== Test de conversion Pandoc ==="
	@mkdir -p $(BUILD_DIR)
	$(PANDOC) $(PANDOC_OPTS) -o $(BUILD_DIR)/test.tex $(MAIN_MD)
	@echo "✅ $(BUILD_DIR)/test.tex"

clean:
	@echo "============================================================"
	@echo "  Nettoyage temporaire (garde les PDF)"
	@echo "============================================================"
	rm -f $(BUILD_DIR)/*.aux $(BUILD_DIR)/*.log $(BUILD_DIR)/*.out $(BUILD_DIR)/*.toc \
		$(BUILD_DIR)/*.idx $(BUILD_DIR)/*.ind $(BUILD_DIR)/*.ilg \
		$(BUILD_DIR)/*.glo $(BUILD_DIR)/*.gls $(BUILD_DIR)/*.glg \
		$(BUILD_DIR)/*.bbl $(BUILD_DIR)/*.bcf $(BUILD_DIR)/*.blg \
		$(BUILD_DIR)/*.run.xml $(BUILD_DIR)/*.fls $(BUILD_DIR)/*.fdb_latexmk \
		$(BUILD_DIR)/*.synctex.gz $(BUILD_DIR)/*.xdv $(BUILD_DIR)/*.glsdefs \
		$(BUILD_DIR)/*.glstex
	# résidus éventuels à la racine (biber mal configuré un jour)
	rm -f $(DOCNAME).bbl $(DOCNAME).blg $(DOCNAME).bcf $(DOCNAME).run.xml
	@echo "✅ Nettoyé"

cleanall: clean
	@echo "============================================================"
	@echo "  Nettoyage complet (build/ + out/)"
	@echo "  Le PDF publié à la racine est CONSERVÉ"
	@echo "============================================================"
	rm -rf $(BUILD_DIR) $(OUT_DIR)
	@echo "✅ Tout nettoyé (racine : $(ROOT_PDF) conservé)"

help:
	@echo "============================================================"
	@echo "  Makefile.tank — $(DOCNAME)"
	@echo "============================================================"
	@echo "  make              → PDF complet + copie à la racine"
	@echo "  make inserer      → FORCE la régénération du MD indexé"
	@echo "  make publish      → recopie out/$(DOCNAME).pdf vers la racine"
	@echo "  make index        → régénère uniquement les index"
	@echo "  make clean        → nettoyage temporaire (garde les PDF)"
	@echo "  make cleanall     → supprime build/ et out/ (garde le PDF racine)"
